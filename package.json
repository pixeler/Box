{
  "name": "friendly-curie-second-brain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "android:sync": "pnpm run build && npx cap sync android",
    "android:build": "pnpm run android:sync && cmd /c \"cd /d android && .\\gradlew.bat assembleRelease --no-daemon\" && powershell -Command \"Copy-Item -Force android\\app\\build\\outputs\\apk\\release\\app-release.apk -Destination .\\SpaceZen-release.apk; Copy-Item -Force android\\app\\build\\outputs\\apk\\release\\app-release.apk -Destination .\\SpaceZen-debug.apk\"",
    "android:install": "C:\\Android\\Sdk\\platform-tools\\adb.exe install -r SpaceZen-release.apk",
    "android:devices": "C:\\Android\\Sdk\\platform-tools\\adb.exe devices -l",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "dependencies": {
    "@blocknote/core": "^0.54.2",
    "@blocknote/mantine": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@remixicon/react": "^4.6.0",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "jalaali-js": "^1.2.7",
    "minisearch": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/jalaali-js": "^1.1.3",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
