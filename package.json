{
  "name": "box",
  "productName": "Box",
  "private": true,
  "version": "0.2.0",
  "description": "A calm, offline-first second brain for notes, tasks, calendar and deep work. Persian-first, local database, optional cloud sync.",
  "license": "MIT",
  "author": {
    "name": "Mahdi Khodadadi",
    "email": "me@pixeler.ir",
    "url": "https://pixeler.ir"
  },
  "homepage": "https://github.com/pixeler/Box#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixeler/Box.git"
  },
  "bugs": {
    "url": "https://github.com/pixeler/Box/issues"
  },
  "keywords": [
    "second-brain",
    "notes",
    "pkm",
    "tasks",
    "focus",
    "persian",
    "rtl",
    "offline-first",
    "electron",
    "capacitor"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "android:sync": "pnpm run build && npx cap sync android",
    "android:build": "pnpm run android:sync && cmd /c \"cd /d android && .\\\\gradlew.bat assembleRelease --no-daemon\" && powershell -Command \"Copy-Item -Force android\\\\app\\\\build\\\\outputs\\\\apk\\\\release\\\\app-release.apk -Destination .\\\\Box-release.apk; Copy-Item -Force android\\\\app\\\\build\\\\outputs\\\\apk\\\\release\\\\app-release.apk -Destination .\\\\Box-debug.apk\"",
    "android:install": "C:\\Android\\Sdk\\platform-tools\\adb.exe install -r Box-release.apk",
    "android:devices": "C:\\Android\\Sdk\\platform-tools\\adb.exe devices -l",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "desktop:build": "vite build && electron-builder --win --dir",
    "desktop:dist": "vite build && electron-builder --win portable",
    "desktop:dist:mac": "vite build && electron-builder --mac",
    "desktop:dev": "electron ."
  },
  "dependencies": {
    "@blocknote/core": "^0.54.2",
    "@blocknote/mantine": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@remixicon/react": "^4.6.0",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "jalaali-js": "^1.2.7",
    "lucide-react": "^1.61.0",
    "minisearch": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/jalaali-js": "^1.1.3",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.pixeler.box",
    "productName": "Box",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "electronLanguages": [
      "fa",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Box-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "artifactName": "Box-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "box",
      "synopsis": "Persian-first offline notes, tasks and focus",
      "maintainer": "Mahdi Khodadadi <me@pixeler.ir>"
    }
  }
}
